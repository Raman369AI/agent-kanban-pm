# Agent Kanban PM — example environment variables.
# Copy to `.env` and edit. Every variable is optional; defaults are shown
# in comments. Loaded automatically via python-dotenv on server/CLI start.

# --- Server / instance ---
# Force the HTTP port the board UI and API listen on (default: 8000, or the
# next free port above 8000 for secondary git worktrees).
# KANBAN_PORT=8000

# Force the base URL used by CLI subcommands and role supervisors to reach
# the API (default: http://localhost:${KANBAN_PORT}).
# KANBAN_API_BASE=http://localhost:8000

# Override the per-instance tag used to derive port/tmux/db paths for
# worktrees (default: derived from the project root path hash).
# KANBAN_INSTANCE_ID=review

# Force the project root used for instance isolation
# (default: git worktree root, else CWD).
# KANBAN_PROJECT_ROOT=/path/to/repo

# --- Database ---
# SQLAlchemy URL. Defaults to ./kanban.db for the primary worktree, or
# .kanban/instances/<id>/kanban.db for a secondary worktree.
# DATABASE_URL=sqlite+aiosqlite:///./kanban.db

# --- Local user identity (used by `kanban run` to seed the owner entity) ---
# KANBAN_USER_NAME=Your Name
# KANBAN_USER_EMAIL=you@example.com

# --- Agent / MCP identity (set when launching an agent CLI) ---
# Name and role the MCP server authenticates as.
# KANBAN_AGENT_NAME=claude
# KANBAN_AGENT_ROLE=worker

# Entity ID to act as for `kanban chat` (default: resolved from token).
# KANBAN_ENTITY_ID=1

# --- Runtime escape hatches ---
# Pin a workspace path for the server's startup context (default: CWD).
# KANBAN_ACTIVE_WORKSPACE=/path/to/workspace

# Override the package data root (templates/static/agents). Mainly for
# development from a source checkout.
# KANBAN_PACKAGE_ROOT=/path/to/agent_kanban_pm

# Echo all SQL statements to the log (debug).
# SQLALCHEMY_ECHO=0
